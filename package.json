{
  "name": "ppks-odhiv-sumut-secure-dashboard",
  "private": true,
  "version": "1.0.12",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ppks-odhiv-auth",
    "db:migrate:local": "wrangler d1 execute ppks-odhiv-auth --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute ppks-odhiv-auth --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@simplewebauthn/server": "^13.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.149.0"
  }
}
